// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id                       Int          @id @default(autoincrement())
  nombres                  String
  apellidos                String
  email                    String       @unique
  rol_staff                String?
  contrato                 String?
  modalidad                String?
  experiencia              String?
  origen                   String?
  skills                   String?
  desempeno_ley_dto        String?
  coordinacion             String?
  presencialidad           String?
  cumpleanos               String?
  comentario               String?
  activo                   Boolean      @default(true)
  hhee                     Boolean      @default(false)
  ur                       Boolean      @default(false)
  proyectos                Proyecto[]   @relation("ProyectoToStaff")
  proyectos_responsable    Proyecto[]   @relation("ResponsableProyecto")
  proyectos_subresponsable Proyecto[]   @relation("SubresponsableProyecto")
  User                     User?
}

model Proyecto {
  id                      Int           @id @default(autoincrement())
  nombre                  String
  codigo_trazabilidad     String?
  descripcion             String?
  staff                   Staff[]       @relation("ProyectoToStaff")
  id_responsable          Int?
  responsable             Staff?        @relation("ResponsableProyecto", fields: [id_responsable], references: [id])
  id_subresponsable       Int?
  subresponsable          Staff?        @relation("SubresponsableProyecto", fields: [id_subresponsable], references: [id])
  fecha_inicio            DateTime?
  fecha_fin               DateTime?
  id_status_redmine       Int?
  status_redmine          String?
  id_plataforma           Int?
  plataforma              String?
  id_area_funcional       Int?
  area_funcional          String?
  id_tipo_desarrollo      Int?
  tipo_desarrollo         String?
  id_etapa_actual         Int?
  etapa_actual            String?
  id_control_versiones    Int?
  control_versiones       String?
  url_control_versiones   String?
  id_tipo_sistema         Int?
  tipo_sistema            String?
  id_alojamiento_infra    Int?
  alojamiento_infra       String?
  id_alojamiento_infra_db Int?
  alojamiento_infra_db    String?
  mantenimiento_soporte   Boolean?
  id_status_pmo           Int?
  status_pmo              String?
  id_status_salud         Int?
  status_salud            String?
  anio_inicio_sistema     Int?
  usuarios_internos       Int?
  usuarios_externos       Int?
  url_sistema             String?
  url_sistema_desarrollo  String?
  url_repositorio         String?
  url_manual_tecnico      String?
  url_manual_usuario      String?
  url_documentacion       String?
  url_incidencias         String?
  url_changelog           String?
  changelog               Boolean?
  clientes                Cliente[]     @relation("ProyectoClientes")
}

model Cliente {
  id                      Int       @id @default(autoincrement())
  nombre                  String
  id_proyecto             Int
  proyecto                Proyecto  @relation("ProyectoClientes", fields: [id_proyecto], references: [id])
  email                   String?
  celular                 String?
  observacion             String?
  activo                  Boolean   @default(true)
  fecha_inicio_desarrollo DateTime?
}

// Modelos de DPR
model DPR_Area {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_Plataforma {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_TipoDesarrollo {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_EtapaActual {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_ControlVersiones {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_TipoSistema {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_AlojamientoInfra {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_StatusPmo {
  id     Int    @id @default(autoincrement())
  nombre String
}

model DPR_StatusSalud {
  id     Int    @id @default(autoincrement())
  nombre String
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff    @relation(fields: [staffId], references: [id])
  staffId   Int      @unique
  role      String   @default("USER")
}