{
  "name": "sigma-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "import:staff": "tsx prisma/import_staff.ts",
    "db:schema": "npx prisma migrate reset --force",
    "db:migrate:dpr": "npx tsx prisma/migrate_dpr.ts",
    "db:migrate:sigma": "npx tsx prisma/migrate_sigma.ts",
    "db:migrate:staff": "npx tsx prisma/migrate_staff.ts",
    "db:reset": "npm run db:schema && npm run db:migrate:dpr && npm run db:migrate:sigma && npm run db:migrate:staff",
    "db:setup": "npx prisma migrate reset --force && npx prisma migrate dev --name init && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/x-charts": "^8.12.0",
    "@prisma/client": "^6.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react-chartjs-2": "^2.0.2",
    "ar-poncho": "^2.0.320",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "^14.2.33",
    "papaparse": "^5.5.3",
    "puppeteer": "^24.26.1",
    "react": "18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.3",
    "prisma": "^6.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
